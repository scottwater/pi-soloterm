{
  "name": "pi-solo-term-tools",
  "version": "0.1.1",
  "type": "module",
  "description": "Optional Pi extension that exposes a focused SoloTerm MCP surface as native Pi tools.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "solo",
    "soloterm",
    "subagents",
    "mcp"
  ],
  "license": "MIT",
  "author": "Scott Watermasysk",
  "scripts": {
    "test": "npm run typecheck && npm run test:unit",
    "pack:dry-run": "npm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "typebox": "^1.0.56",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.14.1",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ]
}
